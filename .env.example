# --- API (services/api) ---
DATABASE_URL=postgresql+psycopg://ll_app:ll_app_dev@localhost:5432/labellens
MIGRATION_DATABASE_URL=postgresql+psycopg://ll_owner:ll_owner_dev@localhost:5432/labellens
# Supabase JWT verification: set EITHER the HS256 secret OR the JWKS URL
SUPABASE_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
SUPABASE_JWKS_URL=
JWT_AUDIENCE=authenticated
# Storage: "local" (dev/test) or "supabase"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
STORAGE_SIGNING_SECRET=dev-only-signing-secret
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=scan-images
SIGNED_URL_TTL_SECONDS=300
# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
